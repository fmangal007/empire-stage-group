{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "empire-stage-group",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/images/*",
      "!/*.ics"
    ],
    "not_found_handling": "404-page"
  }
}
